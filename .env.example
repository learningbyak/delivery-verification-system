# ============================================================
# SAFE TO EXPOSE TO THE BROWSER (NEXT_PUBLIC_* is bundled client-side)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# MUST NEVER BE EXPOSED TO THE BROWSER
# Never prefix these with NEXT_PUBLIC_. Server-side use only.
# See src/lib/supabase/server.ts for where this is allowed to be used.
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=

# PDF parser microservice (parser-service/) — server-to-server only,
# the browser never talks to this directly. PDF_PARSER_SERVICE_TOKEN
# must match the same value the parser service itself is configured
# with (its PARSER_SERVICE_TOKEN env var).
PDF_PARSER_SERVICE_URL=
PDF_PARSER_SERVICE_TOKEN=
